<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/ghostwhite">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnPendingBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" android:contentDescription="Back" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pending Sync" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/black" />
    </LinearLayout>
    <TextView android:id="@+id/txtPendingEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="No pending or failed items" android:textColor="@color/gray" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/pendingList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>