<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/ghostwhite">

    <!-- Top Bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_margin="12dp" android:background="@drawable/bg_page_title" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
        <ImageButton android:id="@+id/bttnBack" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_menu" app:tint="@color/white" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="@string/menu"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/Reports" android:textSize="25sp" android:textStyle="bold" android:gravity="center" android:textColor="@color/white"/>
        <Space android:layout_width="40dp" android:layout_height="40dp"/>
    </LinearLayout>

    <!-- Report Chips -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="horizontal" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:id="@+id/tabMovement" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:paddingHorizontal="18dp" android:paddingVertical="9dp" android:text="@string/stock_movement" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/white" android:background="@drawable/bg_selected"/>
            <TextView android:id="@+id/tabLowStock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:paddingHorizontal="18dp" android:paddingVertical="9dp" android:text="@string/low_stock" android:textSize="13sp" android:textColor="@color/gray" android:background="@drawable/bg_unselected"/>
            <TextView android:id="@+id/tabDisposal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:paddingHorizontal="18dp" android:paddingVertical="9dp" android:text="@string/disposal" android:textSize="13sp" android:textColor="@color/gray" android:background="@drawable/bg_unselected"/>
            <TextView android:id="@+id/tabCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:paddingHorizontal="18dp" android:paddingVertical="9dp" android:text="@string/category" android:textSize="13sp" android:textColor="@color/gray" android:background="@drawable/bg_unselected"/>
            <TextView android:id="@+id/tabLocation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="18dp" android:paddingVertical="9dp" android:text="@string/location" android:textSize="13sp" android:textColor="@color/gray" android:background="@drawable/bg_unselected"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Per-tab header widgets: only one visible at a time -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp">

        <!-- Stock Movement: segmented filter -->
        <LinearLayout android:id="@+id/segmentRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp" android:padding="4dp" android:background="@color/white">
            <TextView android:id="@+id/segAll" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="8dp" android:text="@string/all_filter" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/segIn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="8dp" android:text="@string/in" android:textSize="12sp"/>
            <TextView android:id="@+id/segOut" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="8dp" android:text="@string/out" android:textSize="12sp"/>
            <TextView android:id="@+id/segAdjust" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="8dp" android:text="@string/adjustment" android:textSize="12sp"/>
        </LinearLayout>

        <!-- Low Stock: search + filter -->
        <LinearLayout android:id="@+id/lowStockHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="14dp" android:gravity="center_vertical">
                <LinearLayout android:id="@+id/searchBar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:padding="10dp" android:gravity="center_vertical" android:background="@color/white">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_search" android:layout_marginEnd="6dp" android:contentDescription="@string/search"/>
                    <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@android:color/transparent" android:hint="Search items..." android:textSize="13sp" android:inputType="text" android:maxLines="1"/>
                </LinearLayout>
                <ImageView android:id="@+id/btnFilter" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="10dp" android:padding="10dp" android:src="@drawable/ic_filter" android:contentDescription="@string/filter"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Disposal: summary count cards -->
        <LinearLayout android:id="@+id/disposalHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone" android:layout_marginBottom="16dp">
            <LinearLayout android:id="@+id/dispPendingCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:orientation="vertical" android:gravity="center" android:padding="11dp" android:background="@color/white">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pending" android:textSize="10.5sp" android:textColor="@color/gray_blue"/>
                <TextView android:id="@+id/dispPendingCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/orange"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/dispApprovedCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:orientation="vertical" android:gravity="center" android:padding="11dp" android:background="@color/white">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/approved" android:textSize="10.5sp" android:textColor="@color/gray_blue"/>
                <TextView android:id="@+id/dispApprovedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/green"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/dispRejectedCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="11dp" android:background="@color/white">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/disposed" android:textSize="10.5sp" android:textColor="@color/gray_blue"/>
                <TextView android:id="@+id/dispDisposedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/placeholder" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/red"/>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <!-- Content: drag downward to reload the currently selected report tab. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMovement"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerLowStock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDisposal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCategory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerLocation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <!-- Simple loading indicator, shown/hidden per tab while its call is in flight -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Empty state, shown when a tab's list comes back empty -->
        <TextView
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_data_available"
            android:textColor="@color/gray_blue"
            android:textSize="13sp"
            android:visibility="gone" />

    </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Bottom Navigation -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:baselineAligned="false" android:orientation="horizontal" android:background="@color/white" android:elevation="8dp" android:weightSum="5">
        <LinearLayout android:id="@+id/navDashboard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_home" android:contentDescription="@string/DB"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/DB" android:textSize="11sp" android:textColor="@color/gray"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navItems" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_item" android:contentDescription="@string/Item"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/Item" android:textSize="11sp" android:textColor="@color/gray"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navReports" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_folder" android:contentDescription="@string/Reports"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/Reports" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/dark_gray"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navNotifications" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <FrameLayout android:layout_width="34dp" android:layout_height="26dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="bottom|center_horizontal" android:src="@drawable/ic_notif" android:contentDescription="@string/Notif"/>
                <TextView android:id="@+id/txtNotificationBadge" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_gravity="top|end" android:gravity="center" android:includeFontPadding="false" android:minWidth="18dp" android:textColor="@color/red" android:textSize="12sp" android:textStyle="bold" android:visibility="gone"/>
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:autoSizeMaxTextSize="11sp" android:autoSizeMinTextSize="8sp" android:autoSizeStepGranularity="1sp" android:autoSizeTextType="uniform" android:gravity="center" android:maxLines="1" android:text="@string/Notif" android:textSize="11sp" android:textColor="@color/gray"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navDisposal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_trashbin" android:contentDescription="@string/disposal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/disposal" android:textSize="11sp" android:textColor="@color/gray"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
