<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="64dp"
    android:background="@color/dark_navy" android:gravity="center_vertical"
    android:paddingHorizontal="12dp">
    <ImageButton android:id="@+id/btnBack" android:layout_width="48dp"
        android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back" android:padding="12dp"
        android:src="@drawable/ic_back" />
    <TextView android:id="@+id/txtHeaderTitle" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Profile &amp; Settings"
        android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
</LinearLayout>
