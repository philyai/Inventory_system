<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="InventorySession.xml" />
        <exclude domain="sharedpref" path="BackendPreferences.xml" />
        <exclude domain="database" path="inventory_offline.db" />
        <exclude domain="database" path="inventory_offline.db-shm" />
        <exclude domain="database" path="inventory_offline.db-wal" />
        <exclude domain="file" path="pending_items/" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
    <device-transfer>
        <exclude domain="sharedpref" path="InventorySession.xml" />
        <exclude domain="sharedpref" path="BackendPreferences.xml" />
        <exclude domain="database" path="inventory_offline.db" />
        <exclude domain="database" path="inventory_offline.db-shm" />
        <exclude domain="database" path="inventory_offline.db-wal" />
        <exclude domain="file" path="pending_items/" />
    </device-transfer>
</data-extraction-rules>
